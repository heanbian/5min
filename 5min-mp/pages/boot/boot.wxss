.boot {
  min-height: 100vh;
  padding: 120rpx 48rpx calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background:
    radial-gradient(900rpx 420rpx at 50% -8%, #dff0e6 0%, transparent 60%),
    linear-gradient(180deg, #eef6f1 0%, #f2f5f3 52%, #f4f8f5 100%);
}

.boot-brand {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.boot-logo {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
}

.boot-product {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2a24;
  line-height: 1.3;
}

.boot-card {
  width: 100%;
  max-width: 640rpx;
  margin: 0 auto;
  background: #ffffff;
  border: 2rpx solid #d7e5dc;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.boot-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2a24;
  line-height: 1.35;
  margin-bottom: 16rpx;
}

.boot-msg {
  display: block;
  font-size: 28rpx;
  color: #5f6f66;
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.boot-check {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 96rpx;
  padding: 16rpx 8rpx;
  margin: 0 -8rpx 12rpx;
  box-sizing: border-box;
}

.boot-check-hover {
  opacity: 0.7;
}

.boot-box {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #2f9a68;
  border-radius: 10rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.boot-box.is-on {
  background: #2f9a68;
}

.boot-tick {
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 700;
}

.boot-check-label {
  flex: 1;
  font-size: 30rpx;
  color: #1f2a24;
  line-height: 1.4;
  pointer-events: none;
}

.boot-links {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 36rpx;
}

.boot-link {
  padding: 24rpx 32rpx 24rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #248556;
}

.boot-link-hover {
  opacity: 0.65;
}

.boot-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  background: #2f9a68;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.boot-btn-hover {
  opacity: 0.88;
}

.boot-btn.is-off {
  background: #e5f5ec;
  color: #5f6f66;
}
