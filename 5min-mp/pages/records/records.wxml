<view class="shell" style="padding-top: {{navPadTop}}px;">
  <view class="titlebar" style="height: {{navBarHeight}}px;">
    <text class="title">{{tabTitle}}</text>
  </view>
  <view class="title-line"></view>

  <scroll-view scroll-y class="body" show-scrollbar="{{false}}">
    <view class="section-label">{{weekStatsLabel}}</view>
    <view class="stats-row">
      <view class="stat-card">
        <text class="stat-title">{{weekStatsCountLabel}}</text>
        <text class="stat-value">{{periodCount}}</text>
      </view>
      <view class="stat-card">
        <text class="stat-title">{{weekStatsMinsLabel}}</text>
        <view class="stat-value-row">
          <text class="stat-value">{{periodMins}}</text>
          <text class="stat-unit">{{customUnit}}</text>
        </view>
      </view>
    </view>

    <view class="streak-card">
      <view class="streak-main">
        <text class="streak-label">{{streakLabel}}</text>
        <text class="streak-value">{{streakText}}</text>
      </view>
      <view class="share-actions">
        <button class="share-btn" open-type="share">{{shareLabel}}</button>
        <button class="share-btn share-btn-ghost" bindtap="onCopyShare">{{shareCopyLabel}}</button>
        <button class="share-btn share-btn-ghost" bindtap="onExportCsv">{{exportLabel}}</button>
      </view>
    </view>

    <view class="insight-card" wx:if="{{showOvertimeInsight}}">
      <text class="insight-title">{{overtimeInsightTitle}}</text>
      <text class="insight-line">{{overtimeInsightLine}}</text>
      <text class="insight-hint" wx:if="{{overtimeInsightHint}}">{{overtimeInsightHint}}</text>
    </view>

    <view class="history-head">
      <text class="section-label section-label-gap">{{historyLabel}}</text>
      <text class="clear-link" bindtap="onClearHistory">{{historyClear}}</text>
    </view>

    <picker
      mode="selector"
      range="{{filterOptions}}"
      range-key="label"
      value="{{filterIndex}}"
      bindchange="onFilterChange"
    >
      <view class="filter-row">
        <text class="filter-hint">{{historyFilterLabel}}</text>
        <text class="filter-value">{{filterLabel}}</text>
        <text class="filter-caret">▾</text>
      </view>
    </picker>

    <view class="card">
      <block wx:if="{{rows.length === 0}}">
        <text class="empty">{{historyEmpty}}</text>
      </block>
      <block wx:else>
        <block wx:for="{{rows}}" wx:key="key">
          <view class="hist-row">
            <view class="hist-main">
              <text class="hist-scene">{{item.sceneLine}}</text>
              <text class="hist-dur">{{item.durationLine}}</text>
              <text class="hist-time">{{item.timeLine}}</text>
            </view>
            <text
              class="hist-delete"
              data-id="{{item.id}}"
              bindtap="onDeleteRow"
            >{{historyDelete}}</text>
          </view>
          <view wx:if="{{index < rows.length - 1}}" class="row-line"></view>
        </block>
      </block>
    </view>
    <view class="safe-bottom"></view>
  </scroll-view>

</view>