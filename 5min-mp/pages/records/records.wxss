.shell {
  height: 100vh;
  background:
    radial-gradient(720rpx 360rpx at 50% -6%, #dff0e6 0%, transparent 58%),
    linear-gradient(180deg, var(--bg) 0%, var(--bg2) 48%, #f4f8f5 100%);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.titlebar {
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  background: rgba(255, 255, 255, 0.72);
}

.title {
  font-size: var(--title-size);
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.01em;
}

.title-line {
  height: 1px;
  background: rgba(215, 229, 220, 0.85);
}

.body {
  flex: 1;
  height: 0;
  padding: var(--pad-body);
  box-sizing: border-box;
}

.section-label {
  font-size: var(--label-size);
  font-weight: 500;
  color: var(--muted);
  padding-left: 8rpx;
  margin-bottom: 16rpx;
}

.section-label-gap {
  margin-top: var(--section-gap);
}

.stats-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-bottom: var(--section-gap);
}

.streak-card {
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(215, 229, 220, 0.9);
  border-radius: var(--radius-card, 28rpx);
  padding: 32rpx;
  margin-bottom: var(--section-gap);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 36, 0.04);
}

.streak-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.streak-label {
  font-size: 24rpx;
  color: var(--muted);
  font-weight: 500;
}

.streak-value {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--brand-strong);
  line-height: 1.3;
}

.share-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.share-btn {
  flex: 1;
  margin: 0;
  padding: 0 20rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #fff;
  background: var(--brand-strong, #248556);
  border-radius: var(--radius, 44rpx);
  border: none;
}

.share-btn::after {
  border: none;
}

.share-btn-ghost {
  color: var(--brand-strong, #248556);
  background: rgba(229, 245, 236, 0.85);
  border: 2rpx solid rgba(47, 154, 104, 0.18);
}

.insight-card {
  background: rgba(255, 246, 232, 0.72);
  border: 2rpx solid rgba(201, 134, 45, 0.16);
  border-radius: var(--radius-card, 28rpx);
  padding: 32rpx;
  margin-bottom: var(--section-gap);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.insight-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.insight-line {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}

.insight-hint {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.4;
}

.stat-card {
  flex: 1;
  background: rgba(229, 245, 236, 0.55);
  border: 2rpx solid rgba(47, 154, 104, 0.12);
  border-radius: var(--radius-card, 28rpx);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.stat-title {
  font-size: 24rpx;
  color: var(--muted);
  font-weight: 500;
}

.stat-value {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--brand-strong);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.stat-value-row {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 8rpx;
}

.stat-unit {
  font-size: 26rpx;
  color: var(--muted);
  padding-bottom: 8rpx;
}

.card {
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(215, 229, 220, 0.9);
  border-radius: var(--radius-card, 28rpx);
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 36, 0.04);
}

.empty {
  display: block;
  text-align: center;
  color: var(--muted);
  font-size: var(--body-size);
  padding: 56rpx 40rpx;
  line-height: 1.55;
}

.history-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-right: 8rpx;
}

.clear-link {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--danger);
  min-height: 88rpx;
  min-width: 88rpx;
  padding: 16rpx 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.filter-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: var(--row-h, 80rpx);
  padding: 0 28rpx;
  margin-bottom: 16rpx;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius, 44rpx);
}

.filter-hint {
  font-size: 26rpx;
  color: var(--muted);
  margin-right: 16rpx;
}

.filter-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-caret {
  font-size: 24rpx;
  color: var(--muted);
}

.hist-row {
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

.hist-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hist-delete {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--danger);
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 16rpx 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hist-scene {
  font-size: var(--row-title-size, 30rpx);
  font-weight: 500;
  color: var(--ink);
}

.hist-dur,
.hist-time {
  font-size: var(--body-size);
  color: var(--ink);
}

.row-line {
  height: 1px;
  background: var(--line);
  margin-left: 32rpx;
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

