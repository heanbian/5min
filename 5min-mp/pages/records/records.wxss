.shell {
  height: 100vh;
  background: var(--bg2);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.titlebar {
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  background: var(--surface);
}

.title {
  font-size: var(--title-size);
  font-weight: 600;
  color: var(--ink);
}

.title-line {
  height: 1px;
  background: var(--line);
}

.body {
  flex: 1;
  height: 0;
  padding: var(--pad-body);
  box-sizing: border-box;
}

.section-label {
  font-size: var(--label-size);
  font-weight: 500;
  color: var(--muted);
  padding-left: 8rpx;
  margin-bottom: 16rpx;
}

.section-label-gap {
  margin-top: var(--section-gap);
}

.stats-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-bottom: var(--section-gap);
}

.stat-card {
  flex: 1;
  background: var(--surface);
  border-radius: var(--radius);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.stat-title {
  font-size: 24rpx;
  color: var(--muted);
}

.stat-value {
  font-size: 56rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.1;
}

.stat-value-row {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 8rpx;
}

.stat-unit {
  font-size: 26rpx;
  color: var(--muted);
  padding-bottom: 8rpx;
}

.card {
  background: var(--surface);
  border-radius: var(--radius);
  overflow: hidden;
}

.empty {
  display: block;
  text-align: center;
  color: var(--muted);
  font-size: var(--body-size);
  padding: 40rpx;
}

.hist-row {
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hist-scene,
.hist-dur,
.hist-time {
  font-size: var(--body-size);
  color: var(--ink);
}

.row-line {
  height: 1px;
  background: var(--line);
  margin-left: 32rpx;
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

