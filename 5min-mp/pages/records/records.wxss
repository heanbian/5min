.shell {
  --brand: #2f9a68;
  --brand-strong: #248556;
  --surface: #ffffff;
  --ink: #1f2a24;
  --muted: #5f6f66;
  --line: #d7e5dc;
  --bg2: #f2f5f3;
  height: 100vh;
  background: var(--bg2);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.titlebar {
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  background: var(--surface);
}

.title {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--ink);
}

.title-line {
  height: 1px;
  background: var(--line);
}

.body {
  flex: 1;
  height: 0;
  padding: 32rpx;
  box-sizing: border-box;
}

.section-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--muted);
  padding-left: 8rpx;
  margin-bottom: 16rpx;
}

.section-label-gap {
  margin-top: 16rpx;
}

.stats-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: var(--surface);
  border-radius: 28rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.stat-title {
  font-size: 24rpx;
  color: var(--muted);
}

.stat-value {
  font-size: 56rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.1;
}

.stat-value-row {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 8rpx;
}

.stat-unit {
  font-size: 26rpx;
  color: var(--muted);
  padding-bottom: 8rpx;
}

.card {
  background: var(--surface);
  border-radius: 28rpx;
  overflow: hidden;
}

.empty {
  display: block;
  text-align: center;
  color: var(--muted);
  font-size: 28rpx;
  padding: 40rpx;
}

.hist-row {
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hist-scene {
  font-size: 30rpx;
  color: var(--ink);
}

.hist-dur {
  font-size: 28rpx;
  color: var(--ink);
}

.hist-time {
  font-size: 26rpx;
  color: var(--muted);
}

.row-line {
  height: 1px;
  background: var(--line);
  margin-left: 32rpx;
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

.privacy-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.privacy-card {
  width: 100%;
  background: var(--surface);
  border-radius: 32rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.privacy-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
}

.privacy-msg {
  font-size: 28rpx;
  color: var(--muted);
  line-height: 1.5;
}

.privacy-check {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

.check-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 3rpx solid #8a9a90;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.check-on {
  background: var(--brand);
  border-color: var(--brand);
}

.check-mark {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.check-label {
  font-size: 28rpx;
  color: var(--ink);
  flex: 1;
}

.privacy-links {
  display: flex;
  flex-direction: row;
  gap: 32rpx;
}

.link {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--brand-strong);
}

.privacy-btn {
  margin-top: 8rpx;
  height: 100rpx;
  border-radius: 28rpx;
  background: var(--brand);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-btn-off {
  background: #a8c4b4;
  opacity: 0.7;
}
