.shell {
  height: 100vh;
  background:
    radial-gradient(720rpx 360rpx at 50% -6%, #dff0e6 0%, transparent 58%),
    linear-gradient(180deg, var(--bg) 0%, var(--bg2) 48%, #f4f8f5 100%);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.titlebar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 40rpx;
  background: rgba(255, 255, 255, 0.78);
  box-sizing: border-box;
}

.title {
  flex: 1;
  font-size: var(--title-size, 36rpx);
  font-weight: var(--font-weight-title, 600);
  color: var(--ink);
  letter-spacing: 0.01em;
  line-height: 1.3;
  min-width: 0;
}

.title-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  gap: 8rpx;
}

.title-action {
  margin: 0;
  padding: 16rpx 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand-strong, #248556);
  background: transparent;
  border: none;
  line-height: 1.2;
}

.title-action::after {
  border: none;
}

.title-action-hover {
  opacity: 0.65;
}

.title-line {
  height: 1px;
  background: rgba(215, 229, 220, 0.9);
}

.body {
  flex: 1;
  height: 0;
  padding: var(--pad-body);
  box-sizing: border-box;
}

.section-label {
  font-size: var(--label-size, 24rpx);
  font-weight: var(--font-weight-medium, 500);
  color: var(--muted);
  padding-left: 8rpx;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.section-label-gap {
  margin-top: var(--section-gap);
}

.stats-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-bottom: var(--section-gap);
}

.streak-line {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--muted);
  padding-left: 8rpx;
  margin-bottom: var(--section-gap);
  line-height: 1.4;
}

.insight-card {
  background: linear-gradient(180deg, rgba(229, 245, 236, 0.9) 0%, rgba(255, 255, 255, 0.94) 100%);
  border: 2rpx solid rgba(47, 154, 104, 0.16);
  border-radius: var(--radius-card, 28rpx);
  padding: 28rpx 32rpx;
  margin-bottom: var(--section-gap);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 36, 0.04);
}

.insight-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.insight-line {
  font-size: 28rpx;
  color: var(--brand-strong);
  font-weight: 600;
}

.insight-hint {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.45;
}

.stat-card {
  flex: 1;
  background: linear-gradient(180deg, rgba(229, 245, 236, 0.72) 0%, rgba(255, 255, 255, 0.88) 100%);
  border: 2rpx solid rgba(47, 154, 104, 0.14);
  border-radius: var(--radius-card, 28rpx);
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  box-shadow: 0 4rpx 14rpx rgba(31, 42, 36, 0.035);
}

.stat-title {
  font-size: 24rpx;
  color: var(--muted);
  font-weight: 500;
}

.stat-value {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--brand-strong);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.stat-value-row {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 8rpx;
}

.stat-unit {
  font-size: 26rpx;
  color: var(--muted);
  padding-bottom: 8rpx;
}

.card {
  background: var(--card-bg, rgba(255, 255, 255, 0.92));
  border: 2rpx solid var(--card-border, rgba(215, 229, 220, 0.95));
  border-radius: var(--radius-card, 28rpx);
  overflow: hidden;
  box-shadow: var(--card-shadow, 0 6rpx 20rpx rgba(31, 42, 36, 0.045));
}

.empty {
  display: block;
  text-align: center;
  color: var(--muted);
  font-size: var(--body-size);
  padding: 64rpx 40rpx;
  line-height: 1.55;
}

.history-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-right: 8rpx;
}

.clear-link {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--danger);
  min-height: 64rpx;
  min-width: 88rpx;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  border-radius: var(--radius-sm, 24rpx);
}

.clear-link:active {
  background: rgba(210, 85, 74, 0.08);
}

.filter-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: var(--row-h, 80rpx);
  padding: 0 28rpx;
  margin-bottom: 16rpx;
  background: var(--card-bg, rgba(255, 255, 255, 0.92));
  border: 2rpx solid var(--card-border, rgba(215, 229, 220, 0.95));
  border-radius: var(--radius-sm, 24rpx);
  box-shadow: 0 2rpx 8rpx rgba(31, 42, 36, 0.03);
}

.filter-row:active {
  background: rgba(229, 245, 236, 0.45);
}

.filter-hint {
  font-size: 26rpx;
  color: var(--muted);
  margin-right: 16rpx;
}

.filter-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-caret {
  font-size: 24rpx;
  color: var(--muted);
}

.hist-row {
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  transition: background-color 0.12s ease;
}

.hist-row:active {
  background-color: rgba(47, 154, 104, 0.06);
}

.hist-delete:active {
  opacity: 0.7;
}

.hist-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hist-delete {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--danger);
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 16rpx 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hist-scene {
  font-size: var(--row-title-size, 30rpx);
  font-weight: 600;
  color: var(--ink);
}

.hist-dur {
  font-size: var(--body-size);
  color: var(--ink);
  font-weight: 500;
}

.hist-time {
  font-size: 24rpx;
  color: var(--muted);
}

.row-line {
  height: 1px;
  background: var(--line);
  margin-left: 32rpx;
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

