.legal {
  height: 100vh;
  box-sizing: border-box;
  background:
    radial-gradient(720rpx 360rpx at 50% -6%, #dff0e6 0%, transparent 58%),
    linear-gradient(180deg, var(--bg) 0%, var(--bg2) 48%, #f4f8f5 100%);
}

.legal-inner {
  margin: 24rpx 32rpx 0;
  padding: 36rpx 36rpx 0;
  background: var(--card-bg, rgba(255, 255, 255, 0.92));
  border: 2rpx solid var(--card-border, rgba(215, 229, 220, 0.95));
  border-radius: var(--radius-card, 28rpx);
  box-shadow: var(--card-shadow, 0 6rpx 20rpx rgba(31, 42, 36, 0.045));
  box-sizing: border-box;
}

.legal-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.legal-meta {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
  margin-bottom: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 1px solid rgba(215, 229, 220, 0.9);
}

.legal-lede {
  display: block;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.7;
  margin-bottom: 28rpx;
}

.legal-h2 {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  margin: 36rpx 0 16rpx;
  line-height: 1.4;
}

.legal-p {
  display: block;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.7;
  margin-bottom: 16rpx;
}

.legal-list {
  margin: 8rpx 0 16rpx;
}

.legal-li {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.legal-bullet,
.legal-num {
  flex-shrink: 0;
  width: 36rpx;
  font-size: 28rpx;
  color: var(--brand-strong);
  line-height: 1.7;
  font-weight: 600;
}

.legal-li-body {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.7;
}

/* Inside card: space after last rich-text (padding alone is unreliable) */
.legal-card-pad {
  width: 100%;
  height: 72rpx;
}

/* Outside card: page bottom + home indicator */
.legal-bottom-space {
  width: 100%;
  height: calc(80rpx + env(safe-area-inset-bottom));
}
