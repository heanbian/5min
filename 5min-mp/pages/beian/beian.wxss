.page {
  min-height: 100vh;
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #eef6f1;
}

.block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 40rpx;
}

.label {
  font-size: 30rpx;
  color: #8a9b92;
  line-height: 1.5;
}

.value {
  font-size: 30rpx;
  color: #1f2a24;
  line-height: 1.5;
  word-break: break-all;
}
