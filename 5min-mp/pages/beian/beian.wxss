.page {
  --brand: #2f9a68;
  --brand-strong: #248556;
  --brand-soft: #e5f5ec;
  --bg: #eef6f1;
  --surface: rgba(255, 255, 255, 0.86);
  --ink: #1f2a24;
  --muted: #6a7a71;
  --line: rgba(215, 229, 220, 0.95);
  --pad-x: 40rpx;

  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx var(--pad-x) calc(56rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: stretch;
  overflow: hidden;
  background: linear-gradient(165deg, #eaf6ef 0%, #f5faf7 42%, #f8fbf9 100%);
}

.glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(2rpx);
  pointer-events: none;
  z-index: 0;
}

.glow-a {
  width: 420rpx;
  height: 420rpx;
  top: -120rpx;
  right: -140rpx;
  background: radial-gradient(circle, rgba(47, 154, 104, 0.18) 0%, transparent 70%);
}

.glow-b {
  width: 360rpx;
  height: 360rpx;
  left: -160rpx;
  top: 280rpx;
  background: radial-gradient(circle, rgba(36, 133, 86, 0.12) 0%, transparent 72%);
}

.hero,
.panel,
.foot {
  position: relative;
  z-index: 1;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 44rpx;
  padding-top: 12rpx;
}

.hero-logo {
  width: 176rpx;
  height: 52rpx;
}

.hero-kicker {
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0.12em;
  color: var(--muted);
  text-align: center;
}

.panel {
  padding: 12rpx 8rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 36rpx;
  backdrop-filter: blur(18px);
  box-shadow:
    0 2rpx 0 rgba(255, 255, 255, 0.8) inset,
    0 24rpx 60rpx rgba(31, 42, 36, 0.08);
}

.item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 28rpx;
  border-radius: 28rpx;
}

.item-hover {
  background: rgba(229, 245, 236, 0.55);
}

.item-mark {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #2f9a68 0%, #248556 100%);
  box-shadow: 0 10rpx 20rpx rgba(47, 154, 104, 0.28);
}

.item-mark-soft {
  background: linear-gradient(145deg, #e8f6ee 0%, #d8eee2 100%);
  box-shadow: none;
  border: 2rpx solid #cfe6d8;
}

.item-index {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: #ffffff;
}

.item-mark-soft .item-index {
  color: var(--brand-strong);
}

.item-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.item-label {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.14em;
  color: var(--muted);
}

.item-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.35;
  letter-spacing: 0.01em;
  word-break: break-all;
}

.item-value-link {
  color: var(--brand-strong);
  font-size: 32rpx;
}

.item-action {
  flex-shrink: 0;
  align-self: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted);
  padding: 10rpx 4rpx 10rpx 8rpx;
}

.item-action-accent {
  color: var(--brand-strong);
}

.rule {
  height: 2rpx;
  margin: 0 28rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--line) 12%,
    var(--line) 88%,
    transparent 100%
  );
}

.foot {
  margin-top: auto;
  padding-top: 56rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.foot-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #b7d0c2;
}

.foot-text {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.2em;
  color: #8a9b92;
}
