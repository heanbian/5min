.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #f2f5f3;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icp {
  font-size: 32rpx;
  font-weight: 500;
  color: #1f2a24;
  line-height: 1.5;
  text-align: center;
  word-break: break-all;
}
