.page {
  --brand: #2f9a68;
  --brand-strong: #248556;
  --brand-soft: #e5f5ec;
  --bg: #eef6f1;
  --bg-2: #f7faf8;
  --bg-bottom: #f4f8f5;
  --surface: #ffffff;
  --ink: #1f2a24;
  --muted: #5f6f66;
  --line: #d7e5dc;
  --ring: #cfe0d6;
  --ghost-bg: #e8ecea;
  --ghost-ink: #6b7570;
  --ghost-line: #d5dbd7;
  --warn: #c9862d;
  --warn-soft: #fff6e8;
  --danger: #d2554a;
  --danger-soft: #ffefed;
  /* 首页操作按钮 / 场景选择 / 芯片统一大圆角（22px） */
  --radius: 44rpx;
  --control-h: 104rpx;
  --row-h: 80rpx;
  --pad-x: 40rpx;
  --pad-y: 36rpx;
  --section-gap: 40rpx;
  --stage-gap: 36rpx;
  --dial-size: 520rpx;

  box-sizing: border-box;
  min-height: 100vh;
  padding-left: var(--pad-x);
  padding-right: var(--pad-x);
  padding-bottom: calc(var(--pad-y) + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(900rpx 420rpx at 50% -8%, #dff0e6 0%, transparent 60%),
    linear-gradient(180deg, var(--bg) 0%, var(--bg-2) 52%, var(--bg-bottom) 100%);
}

.page.page-warn {
  background:
    radial-gradient(900rpx 420rpx at 50% -8%, #ffe9c8 0%, transparent 60%),
    linear-gradient(180deg, var(--warn-soft) 0%, #fffaf2 100%);
}

.page.page-done {
  background:
    radial-gradient(900rpx 420rpx at 50% -8%, #ffd7d2 0%, transparent 60%),
    linear-gradient(180deg, var(--danger-soft) 0%, #fff7f6 100%);
}

.topbar {
  position: relative;
  z-index: 30;
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: var(--section-gap);
  box-sizing: border-box;
}

.brand {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
  flex: 1;
  height: 100%;
  margin-right: 16rpx;
}

.brand-logo {
  width: 148rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.brand-title {
  min-width: 0;
  flex: 1;
  font-size: var(--title-size);
  font-weight: 600;
  letter-spacing: 0.01em;
  color: var(--ink);
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-tools {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-left: auto;
  flex-shrink: 0;
  height: 100%;
}

.tool-wrap {
  position: relative;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: -8rpx;
}

.icon-volume {
  width: 40rpx;
  height: 40rpx;
}

.dial-placeholder {
  border-radius: 50%;
  border: 16rpx solid var(--ring);
  box-sizing: border-box;
  background: transparent;
}

.stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--stage-gap);
  margin-bottom: var(--section-gap);
}

.dial {
  position: relative;
  width: var(--dial-size);
  height: var(--dial-size);
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes dial-pulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.018);
    opacity: 0.92;
  }
}

.page-warn .dial {
  animation: dial-pulse 1.8s ease-in-out infinite;
}

.page-done .dial {
  animation: dial-pulse 1.25s ease-in-out infinite;
}

.dial-canvas {
  width: 100%;
  height: 100%;
}

.cue {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx;
  width: 100%;
}

.status {
  width: 90%;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
  color: var(--muted);
}

.status-done {
  font-weight: 600;
  color: var(--danger);
}

.page-warn .status {
  color: var(--warn);
}

.page-done .status {
  color: var(--danger);
}

.stats {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--muted);
  text-align: center;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.stats-label {
  color: var(--muted);
  font-weight: 500;
}

.stats-val {
  color: var(--ink);
  font-weight: 600;
}

/* 实心圆分隔点：比 · 更粗、品牌色更醒目 */
.stats-sep-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: var(--brand-strong);
  flex-shrink: 0;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: var(--section-gap);
}

.controls {
  display: flex;
  gap: 20rpx;
}

/* 三级操作：主按钮抬升 → 次按钮描边 → 忽略为弱化文字动作 */
.btn {
  flex: 1;
  box-sizing: border-box;
  height: var(--control-h);
  line-height: var(--control-h);
  margin: 0;
  padding: 0;
  border-radius: var(--radius);
  font-size: 32rpx;
  font-weight: 600;
}

.btn::after {
  border: none;
}

.btn-primary {
  color: #fff;
  background: linear-gradient(180deg, #36a872 0%, var(--brand) 55%, var(--brand-strong) 100%);
  box-shadow: 0 10rpx 24rpx rgba(47, 154, 104, 0.32);
}

.btn-primary:active {
  background: var(--brand-strong);
  box-shadow: 0 4rpx 12rpx rgba(47, 154, 104, 0.22);
}

.btn-ghost {
  color: var(--muted);
  background: var(--surface);
  border: 2rpx solid var(--line);
  line-height: calc(var(--control-h) - 4rpx);
  box-shadow: 0 4rpx 12rpx rgba(31, 42, 36, 0.04);
}

.btn-ghost:active {
  background: var(--brand-soft);
  border-color: rgba(47, 154, 104, 0.35);
  color: var(--brand-strong);
}

.btn-ghost-disabled,
.btn-ghost[disabled] {
  color: rgba(95, 111, 102, 0.38);
  background: rgba(255, 255, 255, 0.65);
  border-color: var(--line);
  box-shadow: none;
}

.btn-ignore {
  display: block;
  width: 100% !important;
  box-sizing: border-box;
  margin: 0 !important;
  padding: 0;
  height: var(--control-h);
  line-height: calc(var(--control-h) - 4rpx);
  border-radius: var(--radius);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--danger);
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx dashed rgba(210, 85, 74, 0.45);
}

.btn-ignore::after {
  border: none;
}

.btn-ignore:active {
  background: var(--danger-soft);
  border-color: var(--danger);
  color: #b9443b;
}

/* 快捷芯片：薄荷软胶囊，与主区白底表单/按钮区分 */
.suggested-chips {
  width: 100%;
  white-space: nowrap;
  height: auto;
  padding: 12rpx;
  box-sizing: border-box;
  border-radius: var(--radius);
  background: rgba(229, 245, 236, 0.72);
  border: 2rpx solid rgba(47, 154, 104, 0.12);
}

.suggested-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: var(--suggested-chip-h, 64rpx);
  padding: 0 28rpx;
  margin-right: 12rpx;
  border-radius: var(--radius);
  border: 2rpx solid rgba(47, 154, 104, 0.18);
  background: rgba(255, 255, 255, 0.55);
  color: var(--brand-strong);
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(47, 154, 104, 0.06);
}

.suggested-chip:last-child {
  margin-right: 0;
}

.suggested-chip.is-active {
  border-color: transparent;
  background: linear-gradient(180deg, #36a872 0%, var(--brand) 100%);
  color: #fff;
  box-shadow: 0 6rpx 14rpx rgba(47, 154, 104, 0.28);
}

.suggested-chip.disabled {
  opacity: 0.4;
  pointer-events: none;
  box-shadow: none;
}

.scene-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  height: var(--row-h);
  padding: 0 28rpx;
  border-radius: var(--radius);
  border: 2rpx solid var(--line);
  background: var(--surface);
}

.scene-trigger.disabled {
  opacity: 0.4;
}

.scene-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scene-trigger.is-placeholder .scene-value {
  color: var(--muted);
}

.scene-caret {
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1;
  color: var(--muted);
}

.ritual-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(31, 42, 36, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.ritual-card {
  width: 100%;
  max-width: 620rpx;
  background: var(--surface);
  border-radius: var(--radius-dialog, 32rpx);
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
}

.ritual-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 28rpx;
}

.ritual-step {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 72rpx;
  padding: 8rpx 0;
}

.ritual-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--line);
  background: var(--surface);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ritual-check.on {
  background: var(--brand);
  border-color: var(--brand);
}

.ritual-step-label {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}

.ritual-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.ritual-btn {
  flex: 1;
  height: var(--control-h, 104rpx);
  border-radius: var(--radius, 44rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.ritual-btn-ghost {
  background: var(--ghost-bg);
  color: var(--muted);
}

.ritual-btn-primary {
  background: var(--brand);
  color: #fff;
}

