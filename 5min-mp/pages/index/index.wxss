.page {
  --brand: #2f9a68;
  --brand-strong: #248556;
  --brand-soft: #e5f5ec;
  --bg: #eef6f1;
  --bg-2: #f7faf8;
  --bg-bottom: #f4f8f5;
  --surface: #ffffff;
  --ink: #1f2a24;
  --muted: #5f6f66;
  --line: #d7e5dc;
  --ring: #cfe0d6;
  --ghost-bg: #e8ecea;
  --ghost-ink: #6b7570;
  --ghost-line: #d5dbd7;
  --warn: #c9862d;
  --warn-soft: #fff6e8;
  --danger: #d2554a;
  --danger-soft: #ffefed;
  --radius: 28rpx;
  --control-h: 104rpx;
  --row-h: 80rpx;
  --pad-x: 40rpx;
  --pad-y: 36rpx;
  --section-gap: 40rpx;
  --stage-gap: 36rpx;
  --dial-size: 520rpx;

  box-sizing: border-box;
  min-height: 100vh;
  padding-left: var(--pad-x);
  padding-right: var(--pad-x);
  padding-bottom: calc(var(--pad-y) + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(900rpx 420rpx at 50% -8%, #dff0e6 0%, transparent 60%),
    linear-gradient(180deg, var(--bg) 0%, var(--bg-2) 52%, var(--bg-bottom) 100%);
}

.page.page-warn {
  background:
    radial-gradient(900rpx 420rpx at 50% -8%, #ffe9c8 0%, transparent 60%),
    linear-gradient(180deg, var(--warn-soft) 0%, #fffaf2 100%);
}

.page.page-done {
  background:
    radial-gradient(900rpx 420rpx at 50% -8%, #ffd7d2 0%, transparent 60%),
    linear-gradient(180deg, var(--danger-soft) 0%, #fff7f6 100%);
}

.topbar {
  position: relative;
  z-index: 30;
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: var(--section-gap);
  box-sizing: border-box;
}

.brand {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
  flex: 1;
  height: 100%;
  margin-right: 16rpx;
}

.brand-logo {
  width: 148rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.brand-title {
  min-width: 0;
  flex: 1;
  font-size: var(--title-size);
  font-weight: 600;
  letter-spacing: 0.01em;
  color: var(--ink);
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-tools {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-left: auto;
  flex-shrink: 0;
  height: 100%;
}

.tool-wrap {
  position: relative;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: -8rpx;
}

.icon-volume {
  width: 40rpx;
  height: 40rpx;
}

.dial-placeholder {
  border-radius: 50%;
  border: 16rpx solid var(--ring);
  box-sizing: border-box;
  background: transparent;
}

.stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--stage-gap);
  margin-bottom: var(--section-gap);
}

.dial {
  position: relative;
  width: var(--dial-size);
  height: var(--dial-size);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dial-canvas {
  width: 100%;
  height: 100%;
}

.cue {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx;
  width: 100%;
}

.status {
  width: 90%;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
  color: var(--muted);
}

.status-done {
  font-weight: 600;
  color: var(--danger);
}

.page-warn .status {
  color: var(--warn);
}

.page-done .status {
  color: var(--danger);
}

.stats {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--muted);
  text-align: center;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: var(--section-gap);
}

.controls {
  display: flex;
  gap: 20rpx;
}

.btn {
  flex: 1;
  height: var(--control-h);
  line-height: var(--control-h);
  margin: 0;
  padding: 0;
  border-radius: var(--radius);
  font-size: 32rpx;
  font-weight: 600;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--brand);
  color: #fff;
}

.btn-primary:active {
  background: var(--brand-strong);
}

.btn-ghost {
  background: var(--ghost-bg);
  color: var(--ghost-ink);
  border: 2rpx solid var(--ghost-line);
}

.btn-ghost:active {
  background: #dde3e0;
  border-color: #c8d0cc;
  color: #4a554f;
}

.btn-ghost-disabled,
.btn-ghost[disabled] {
  color: rgba(107, 117, 112, 0.4);
  background: var(--ghost-bg);
  border-color: var(--ghost-line);
}

.scene-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  height: var(--row-h);
  padding: 0 28rpx;
  border-radius: var(--radius);
  border: 2rpx solid var(--line);
  background: var(--surface);
}

.scene-trigger.disabled {
  opacity: 0.4;
}

.scene-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scene-trigger.is-placeholder .scene-value {
  color: var(--muted);
}

.scene-caret {
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1;
  color: var(--muted);
}

