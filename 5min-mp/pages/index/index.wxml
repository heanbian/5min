<view class="page page-{{phase}}" style="padding-top: {{navPadTop}}px;">
  <view class="topbar" style="height: {{navBarHeight}}px; padding-right: {{navPadRight}}px;">
    <view class="brand">
      <image class="brand-logo" src="/assets/logo.png" mode="aspectFit" aria-label="5min" />
      <text class="brand-title">{{brandTitle}}</text>
    </view>

    <view class="top-tools">
      <view
        class="icon-btn"
        bindtap="onOpenMine"
        aria-label="{{ambientLabel}}"
      >
        <image
          class="icon-volume"
          src="{{ambient === 'off' ? '/assets/volume.png' : '/assets/volume-on.png'}}"
          mode="aspectFit"
        />
      </view>
    </view>
  </view>

  <view class="stage" aria-label="{{stageLabel}}">
    <view class="dial" bindtap="onDialTap">
      <!-- canvas 为原生层，隐私门打开时必须卸载，否则会盖住普通 view -->
      <canvas
        wx:if="{{privacyAccepted}}"
        type="2d"
        id="progressCanvas"
        class="dial-canvas"
        style="width: {{canvasCss}}px; height: {{canvasCss}}px;"
      ></canvas>
      <view
        wx:else
        class="dial-placeholder"
        style="width: {{canvasCss}}px; height: {{canvasCss}}px;"
      ></view>
    </view>
    <view class="cue">
      <text class="status {{phase === 'done' ? 'status-done' : ''}}">{{statusText}}</text>
      <text class="stats">{{statsText}}</text>
    </view>
  </view>

  <view class="actions" aria-label="{{actionsLabel}}">
    <view class="controls">
      <button class="btn btn-primary" bindtap="onToggle">{{primaryLabel}}</button>
      <button
        class="btn btn-ghost {{canReset ? '' : 'btn-ghost-disabled'}}"
        bindtap="onReset"
        disabled="{{!canReset}}"
      >{{resetLabel}}</button>
    </view>

    <view class="presets {{running ? 'presets-disabled' : ''}}" aria-label="{{presetsLabel}}">
      <block wx:for="{{presetItems}}" wx:key="min">
        <view wx:if="{{index > 0}}" class="preset-divider"></view>
        <view
          class="preset {{activePreset === item.min ? 'preset-on' : ''}}"
          data-min="{{item.min}}"
          bindtap="onPreset"
        >{{item.label}}</view>
      </block>
    </view>

    <picker
      mode="multiSelector"
      range="{{sceneRange}}"
      range-key="label"
      value="{{sceneIndex}}"
      bindchange="onSceneChange"
      bindcolumnchange="onSceneColumnChange"
      disabled="{{running}}"
    >
      <view class="scene-trigger {{running ? 'disabled' : ''}} {{scenePlaceholder ? 'is-placeholder' : ''}}">
        <text class="scene-value">{{sceneTriggerLabel}}</text>
        <text class="scene-caret">▾</text>
      </view>
    </picker>
  </view>

  <view class="footnote">
    <text>{{footnote}}</text>
  </view>

  <view class="privacy-mask" wx:if="{{!privacyAccepted}}">
    <view class="privacy-card">
      <text class="privacy-title">{{privacyTitle}}</text>
      <text class="privacy-msg">{{privacyMessage}}</text>
      <view class="privacy-check" bindtap="onTogglePrivacyCheck">
        <view class="check-box {{privacyChecked ? 'check-on' : ''}}">
          <text wx:if="{{privacyChecked}}" class="check-mark">✓</text>
        </view>
        <text class="check-label">{{privacyCheckLabel}}</text>
      </view>
      <view class="privacy-links">
        <text class="link" bindtap="onOpenPrivacy">{{privacyLink}}</text>
        <text class="link" bindtap="onOpenTerms">{{termsLink}}</text>
      </view>
      <view
        class="privacy-btn {{privacyChecked ? '' : 'privacy-btn-off'}}"
        bindtap="onAcceptPrivacy"
      >{{privacyAgree}}</view>
    </view>
  </view>
</view>
