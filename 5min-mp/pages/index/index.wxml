<view class="page page-{{phase}} {{rtl ? 'rtl' : ''}}" style="padding-top: {{navPadTop}}px;">
  <!-- 自定义顶栏：品牌 + 环境音 / 语言（避开右侧胶囊） -->
  <view class="topbar" style="height: {{navBarHeight}}px; padding-right: {{navPadRight}}px;">
    <view class="brand">
      <image class="brand-logo" src="/assets/logo.png" mode="aspectFit" aria-label="5min" />
      <text class="brand-title">{{brandTitle}}</text>
    </view>

    <view class="top-tools">
      <view class="tool-wrap">
        <view
          class="icon-btn {{ambientOpen || ambient !== 'off' ? 'tool-on' : ''}}"
          bindtap="onAmbientToggle"
          aria-label="{{ambientLabel}}"
        >
          <image
            class="icon-volume"
            src="{{ambientOpen || ambient !== 'off' ? '/assets/volume-on.png' : '/assets/volume.png'}}"
            mode="aspectFit"
          />
        </view>
      </view>

      <view class="tool-wrap">
        <view
          class="lang-btn {{langOpen ? 'tool-on' : ''}}"
          bindtap="onLangToggle"
          aria-label="{{langLabel}}"
        >
          <text class="lang-text">{{localeLabel}}</text>
          <text class="lang-caret">▾</text>
        </view>
      </view>
    </view>
  </view>

  <view class="stage" aria-label="{{stageLabel}}">
    <view class="dial">
      <!-- 菜单打开时隐藏 canvas，避免原生层盖住下拉 -->
      <canvas
        wx:if="{{!ambientOpen && !langOpen}}"
        type="2d"
        id="progressCanvas"
        class="dial-canvas"
        style="width: {{canvasCss}}px; height: {{canvasCss}}px;"
      ></canvas>
      <view
        wx:else
        class="dial-placeholder"
        style="width: {{canvasCss}}px; height: {{canvasCss}}px;"
      ></view>
    </view>
    <view class="cue">
      <text class="status {{phase === 'done' ? 'status-done' : ''}}">{{statusText}}</text>
      <text class="stats">{{statsText}}</text>
    </view>
  </view>

  <view class="actions" aria-label="{{actionsLabel}}">
    <view class="controls">
      <button class="btn btn-primary" bindtap="onToggle">{{primaryLabel}}</button>
      <button
        class="btn btn-ghost {{canReset ? '' : 'btn-ghost-disabled'}}"
        bindtap="onReset"
        disabled="{{!canReset}}"
      >{{resetLabel}}</button>
    </view>

    <view class="presets {{running ? 'presets-disabled' : ''}}" aria-label="{{presetsLabel}}">
      <block wx:for="{{presetItems}}" wx:key="min">
        <view wx:if="{{index > 0}}" class="preset-divider"></view>
        <view
          class="preset {{activePreset === item.min ? 'preset-on' : ''}}"
          data-min="{{item.min}}"
          bindtap="onPreset"
        >{{item.label}}</view>
      </block>
    </view>

    <picker
      mode="multiSelector"
      range="{{sceneRange}}"
      range-key="label"
      value="{{sceneIndex}}"
      bindchange="onSceneChange"
      bindcolumnchange="onSceneColumnChange"
      disabled="{{running}}"
    >
      <view class="scene-trigger {{running ? 'disabled' : ''}} {{scenePlaceholder ? 'is-placeholder' : ''}}">
        <text class="scene-value">{{sceneTriggerLabel}}</text>
        <text class="scene-caret">▾</text>
      </view>
    </picker>
  </view>

  <view class="footnote">
    <text>{{footnote}}</text>
  </view>

  <!-- 下拉层：普通 view，因菜单打开时 canvas 已卸载，不再被原生层遮挡 -->
  <view class="menu-overlay" wx:if="{{ambientOpen || langOpen}}" catchtouchmove="noop">
    <view class="mask" bindtap="onCloseMenus"></view>
    <view
      class="menu-panel {{ambientOpen ? 'ambient-panel' : 'lang-panel'}}"
      style="top: {{menuTop}}px; right: {{menuRight}}px;"
    >
      <block wx:if="{{ambientOpen}}">
        <view
          wx:for="{{ambientOptions}}"
          wx:key="id"
          class="menu-item {{item.active ? 'menu-item-on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onAmbientSelect"
        >{{item.label}}</view>
      </block>
      <block wx:else>
        <view
          wx:for="{{localeOptions}}"
          wx:key="code"
          class="menu-item {{item.active ? 'menu-item-on' : ''}}"
          data-code="{{item.code}}"
          bindtap="onLangSelect"
        >{{item.label}}</view>
      </block>
    </view>
  </view>
</view>
