.shell {
  --brand: #2f9a68;
  --brand-strong: #248556;
  --brand-soft: #e5f5ec;
  --surface: #ffffff;
  --ink: #1f2a24;
  --muted: #5f6f66;
  --line: #d7e5dc;
  --bg2: #f2f5f3;
  height: 100vh;
  background: var(--bg2);
  display: flex;
  flex-direction: column;
}

.titlebar {
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  background: var(--surface);
}

.title {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--ink);
}

.title-line {
  height: 1px;
  background: var(--line);
}

.body {
  flex: 1;
  height: 0;
  padding: 32rpx;
  box-sizing: border-box;
}

.section-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--muted);
  padding-left: 8rpx;
  margin-bottom: 16rpx;
}

.section-gap {
  margin-top: 20rpx;
}

.card {
  background: var(--surface);
  border-radius: 28rpx;
  overflow: hidden;
}

.row {
  min-height: 104rpx;
  padding: 0 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-title {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
}

.row-value {
  font-size: 28rpx;
  color: var(--muted);
  margin-right: 12rpx;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chev {
  font-size: 36rpx;
  color: var(--muted);
}

.row-line {
  height: 1px;
  background: var(--line);
  margin-left: 32rpx;
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 900;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet {
  background: var(--surface);
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  overflow-y: auto;
}

.sheet-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx 40rpx 16rpx;
}

.sheet-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ink);
}

.sheet-close {
  width: 72rpx;
  height: 72rpx;
  text-align: center;
  line-height: 72rpx;
  color: var(--muted);
  font-size: 36rpx;
}

.sheet-item {
  padding: 28rpx 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  text-align: center;
}

.sheet-item-on {
  color: var(--brand-strong);
}

.duration-box {
  padding: 16rpx 40rpx 24rpx;
}

.duration-input {
  height: 88rpx;
  border: 1px solid var(--line);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.quick-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.quick-chip {
  background: var(--brand-soft);
  color: var(--brand-strong);
  font-weight: 600;
  padding: 16rpx 28rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.duration-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: 24rpx;
}

.btn-cancel,
.btn-ok {
  padding: 16rpx 28rpx;
  font-size: 30rpx;
}

.btn-cancel {
  color: var(--muted);
}

.btn-ok {
  color: var(--brand-strong);
  font-weight: 600;
}

.about-box {
  padding: 8rpx 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.about-body {
  font-size: 28rpx;
  color: var(--muted);
  line-height: 1.5;
}

.about-ver {
  font-size: 26rpx;
  color: var(--muted);
}

.about-web {
  font-size: 28rpx;
  color: var(--brand-strong);
}

.about-ok {
  align-self: flex-end;
  margin-top: 8rpx;
}

.privacy-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.privacy-card {
  width: 100%;
  background: var(--surface);
  border-radius: 32rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.privacy-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
}

.privacy-msg {
  font-size: 28rpx;
  color: var(--muted);
  line-height: 1.5;
}

.privacy-check {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

.check-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 3rpx solid #8a9a90;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.check-on {
  background: var(--brand);
  border-color: var(--brand);
}

.check-mark {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.check-label {
  font-size: 28rpx;
  color: var(--ink);
  flex: 1;
}

.privacy-links {
  display: flex;
  flex-direction: row;
  gap: 32rpx;
}

.link {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--brand-strong);
}

.privacy-btn {
  margin-top: 8rpx;
  height: 100rpx;
  border-radius: 28rpx;
  background: var(--brand);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-btn-off {
  background: #a8c4b4;
  opacity: 0.7;
}
