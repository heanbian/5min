.shell {
  height: 100vh;
  background: var(--bg2);
  display: flex;
  flex-direction: column;
}

.titlebar {
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  background: var(--surface);
}

.title {
  font-size: var(--title-size);
  font-weight: 600;
  color: var(--ink);
}

.title-line {
  height: 1px;
  background: var(--line);
}

.body {
  flex: 1;
  height: 0;
  padding: var(--pad-body);
  box-sizing: border-box;
}

.section-label {
  font-size: var(--label-size);
  font-weight: 500;
  color: var(--muted);
  padding-left: 8rpx;
  margin-bottom: 16rpx;
}

.section-gap {
  margin-top: var(--section-gap);
}

.hint {
  margin-top: 12rpx;
  padding: 0 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--muted);
}

.card {
  background: var(--surface);
  border-radius: var(--radius-card, 28rpx);
  overflow: hidden;
}

.row {
  min-height: var(--control-h, 104rpx);
  padding: 0 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-switch switch {
  transform: scale(0.92);
}

.row-title {
  flex: 1;
  font-size: var(--row-title-size);
  color: var(--ink);
}

.row-value {
  font-size: var(--body-size);
  color: var(--muted);
  margin-right: 12rpx;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chev {
  font-size: 36rpx;
  color: var(--muted);
}

.row-line {
  height: 1px;
  background: var(--line);
  margin-left: 32rpx;
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 900;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet {
  background: var(--surface);
  border-radius: var(--radius-sheet, 36rpx) var(--radius-sheet, 36rpx) 0 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  overflow-y: auto;
}

.sheet-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx 40rpx 16rpx;
}

.sheet-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ink);
}

.sheet-close {
  width: 72rpx;
  height: 72rpx;
  text-align: center;
  line-height: 72rpx;
  color: var(--muted);
  font-size: 36rpx;
}

.sheet-item {
  min-height: var(--control-h, 104rpx);
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: var(--row-title-size);
  font-weight: 500;
  color: var(--ink);
  text-align: center;
}

.sheet-item-on {
  color: var(--brand-strong);
}

.sheet-add {
  width: 72rpx;
  height: 72rpx;
  text-align: center;
  line-height: 72rpx;
  color: var(--brand-strong);
  font-size: 40rpx;
  font-weight: 500;
}

.sheet-add-off {
  color: var(--muted);
  opacity: 0.45;
  pointer-events: none;
}

.scenes-box {
  padding: 28rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

.scenes-empty-hint {
  font-size: var(--body-size);
  color: var(--muted);
  text-align: center;
  line-height: 1.5;
}

.scenes-add-btn {
  padding: 20rpx 36rpx;
}

.scenes-list {
  padding: 8rpx 24rpx 24rpx;
}

.scene-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 16rpx;
  border-bottom: 1px solid var(--line);
}

.scene-row:last-child {
  border-bottom: none;
}

.scene-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.scene-name {
  font-size: var(--row-title-size);
  font-weight: 500;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scene-min {
  font-size: 26rpx;
  color: var(--muted);
}

.scene-use {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  background: var(--brand-soft);
  color: var(--brand-strong);
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 16rpx;
}

.scene-del {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  color: var(--muted);
  font-size: 28rpx;
}

.editor-box {
  padding: 8rpx 40rpx 24rpx;
}

.editor-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.editor-label-gap {
  margin-top: 8rpx;
}

.editor-name-input {
  height: var(--control-h, 104rpx);
  border: 1px solid var(--line);
  border-radius: var(--radius, 44rpx);
  padding: 0 28rpx;
  font-size: var(--row-title-size);
  margin-bottom: 40rpx;
  background: var(--ghost-bg, #e8ecea);
  box-sizing: border-box;
}

.editor-min-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.nudge-btn {
  width: var(--control-h, 104rpx);
  height: var(--control-h, 104rpx);
  line-height: var(--control-h, 104rpx);
  text-align: center;
  background: var(--ghost-bg, #e8ecea);
  border: 1px solid var(--line);
  border-radius: var(--radius, 44rpx);
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.editor-min-input {
  flex: 1;
  height: var(--control-h, 104rpx);
  text-align: center;
  font-size: 48rpx;
  font-weight: 500;
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: var(--radius, 44rpx);
  background: var(--ghost-bg, #e8ecea);
  box-sizing: border-box;
}

.quick-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.quick-chip {
  background: var(--brand-soft);
  color: var(--brand-strong);
  font-weight: 600;
  height: var(--row-h, 80rpx);
  line-height: var(--row-h, 80rpx);
  padding: 0 24rpx;
  border-radius: var(--radius-sm, 24rpx);
  font-size: 28rpx;
  box-sizing: border-box;
}

.duration-actions {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 24rpx;
}

.btn-cancel,
.btn-ok {
  padding: 16rpx 28rpx;
  font-size: var(--row-title-size);
}

.btn-cancel {
  color: var(--muted);
}

.btn-ok {
  color: var(--brand-strong);
  font-weight: 600;
}

.btn-ok-off {
  opacity: 0.45;
  pointer-events: none;
}

.feedback-box {
  padding: 8rpx 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.feedback-hint {
  font-size: var(--body-size);
  color: var(--muted);
  text-align: center;
  line-height: 1.5;
}

.feedback-email {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  text-align: center;
  line-height: 1.4;
  word-break: break-all;
  margin-bottom: 12rpx;
}

