.shell {
  position: relative;
  height: 100vh;
  background:
    radial-gradient(720rpx 360rpx at 50% -6%, #dff0e6 0%, transparent 58%),
    linear-gradient(180deg, var(--bg) 0%, var(--bg2) 48%, #f4f8f5 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.titlebar {
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  background: rgba(255, 255, 255, 0.78);
}

.title {
  font-size: var(--title-size, 36rpx);
  font-weight: var(--font-weight-title, 600);
  color: var(--ink);
  letter-spacing: 0.01em;
  line-height: 1.3;
}

.title-line {
  height: 1px;
  background: rgba(215, 229, 220, 0.85);
}

.body {
  flex: 1;
  height: 0;
  padding: var(--pad-body);
  box-sizing: border-box;
}

.section-label {
  font-size: var(--label-size, 24rpx);
  font-weight: var(--font-weight-medium, 500);
  color: var(--muted);
  padding-left: 8rpx;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.section-gap {
  margin-top: var(--section-gap);
}

.hint {
  margin-top: 12rpx;
  padding: 0 8rpx;
  font-size: var(--hint-size, 24rpx);
  line-height: 1.45;
  color: var(--muted);
}

.hint-inset {
  margin-top: 8rpx;
  margin-bottom: 4rpx;
  padding: 0 32rpx;
}

.sync-status {
  margin-top: 12rpx;
  margin-bottom: 4rpx;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 500;
  color: var(--brand-strong);
  background: rgba(229, 245, 236, 0.9);
  border: 2rpx solid rgba(47, 154, 104, 0.16);
  border-radius: var(--radius-sm, 24rpx);
}

.card {
  background: var(--card-bg, rgba(255, 255, 255, 0.92));
  border: 2rpx solid var(--card-border, rgba(215, 229, 220, 0.95));
  border-radius: var(--radius-card, 28rpx);
  overflow: hidden;
  box-shadow: var(--card-shadow, 0 6rpx 20rpx rgba(31, 42, 36, 0.045));
}

.row {
  min-height: var(--row-h, 96rpx);
  padding: 0 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  transition: background-color 0.12s ease;
}

.row:active {
  background-color: rgba(47, 154, 104, 0.08);
}

.row-switch switch {
  transform: scale(0.92);
}

.row-title {
  flex: 1;
  min-width: 0;
  font-size: var(--row-title-size, 30rpx);
  font-weight: var(--font-weight-medium, 500);
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.35;
}

.row-value {
  width: 320rpx;
  max-width: 320rpx;
  flex-shrink: 0;
  font-size: var(--body-size, 28rpx);
  font-weight: var(--font-weight-body, 400);
  color: var(--muted);
  margin-right: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
  line-height: 1.35;
}

.chev {
  width: 32rpx;
  flex-shrink: 0;
  font-size: 32rpx;
  color: var(--muted-soft, #7a8a82);
  text-align: right;
  line-height: 1;
}

.row-line {
  height: 1px;
  background: var(--line);
  margin-left: 32rpx;
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

.storage-extra {
  margin-top: 20rpx;
}

.restore-block {
  padding: 28rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
  box-sizing: border-box;
}

.restore-label {
  display: block;
  margin: 0;
  font-size: var(--row-title-size);
  font-weight: 500;
  color: var(--ink);
  line-height: 1.4;
}

.restore-input {
  width: 100%;
  min-height: 80rpx;
  margin: 0;
  padding: 14rpx 22rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(215, 229, 220, 0.95);
  border-radius: var(--radius-sm, 24rpx);
  font-size: 26rpx;
  color: var(--ink);
  background: rgba(248, 252, 249, 0.95);
}

.restore-hint {
  display: block;
  margin: 0;
  padding: 0;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--muted);
}

.storage-btn {
  width: 100%;
  height: var(--btn-h, 88rpx);
  margin-top: 4rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm, 24rpx);
  background: var(--brand, #2f9a68);
  color: #fff;
  font-size: var(--row-title-size, 30rpx);
  font-weight: var(--font-weight-title, 600);
  box-shadow: 0 6rpx 16rpx rgba(47, 154, 104, 0.2);
}

.storage-btn:active {
  opacity: 0.88;
  transform: scale(0.99);
}

.brand-link {
  color: var(--brand-strong, #2f9a68);
  font-weight: 600;
}
