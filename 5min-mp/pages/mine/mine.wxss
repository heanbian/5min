.shell {
  height: 100vh;
  background: var(--bg2);
  display: flex;
  flex-direction: column;
}

.titlebar {
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  background: var(--surface);
}

.title {
  font-size: var(--title-size);
  font-weight: 600;
  color: var(--ink);
}

.title-line {
  height: 1px;
  background: var(--line);
}

.body {
  flex: 1;
  height: 0;
  padding: var(--pad-body);
  box-sizing: border-box;
}

.section-label {
  font-size: var(--label-size);
  font-weight: 500;
  color: var(--muted);
  padding-left: 8rpx;
  margin-bottom: 16rpx;
}

.section-gap {
  margin-top: var(--section-gap);
}

.card {
  background: var(--surface);
  border-radius: var(--radius);
  overflow: hidden;
}

.row {
  min-height: 104rpx;
  padding: 0 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-title {
  flex: 1;
  font-size: var(--row-title-size);
  color: var(--ink);
}

.row-value {
  font-size: var(--body-size);
  color: var(--muted);
  margin-right: 12rpx;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chev {
  font-size: 36rpx;
  color: var(--muted);
}

.row-line {
  height: 1px;
  background: var(--line);
  margin-left: 32rpx;
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 900;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet {
  background: var(--surface);
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  overflow-y: auto;
}

.sheet-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx 40rpx 16rpx;
}

.sheet-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ink);
}

.sheet-close {
  width: 72rpx;
  height: 72rpx;
  text-align: center;
  line-height: 72rpx;
  color: var(--muted);
  font-size: 36rpx;
}

.sheet-item {
  padding: 28rpx 40rpx;
  font-size: var(--row-title-size);
  font-weight: 500;
  color: var(--ink);
  text-align: center;
}

.sheet-item-on {
  color: var(--brand-strong);
}

.duration-box {
  padding: 16rpx 40rpx 24rpx;
}

.duration-input {
  height: 88rpx;
  border: 1px solid var(--line);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: var(--row-title-size);
  margin-bottom: 24rpx;
}

.quick-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.quick-chip {
  background: var(--brand-soft);
  color: var(--brand-strong);
  font-weight: 600;
  padding: 16rpx 28rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.duration-actions {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 24rpx;
}

.btn-cancel,
.btn-ok {
  padding: 16rpx 28rpx;
  font-size: var(--row-title-size);
}

.btn-cancel {
  color: var(--muted);
}

.btn-ok {
  color: var(--brand-strong);
  font-weight: 600;
}

.feedback-box {
  padding: 8rpx 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.feedback-hint {
  font-size: var(--body-size);
  color: var(--muted);
  text-align: center;
  line-height: 1.5;
}

.feedback-email {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  text-align: center;
  line-height: 1.4;
  word-break: break-all;
  margin-bottom: 12rpx;
}

