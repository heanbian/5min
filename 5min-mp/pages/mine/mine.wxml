<view class="shell" style="padding-top: {{navPadTop}}px;">
  <view class="titlebar" style="height: {{navBarHeight}}px;">
    <text class="title">{{tabTitle}}</text>
  </view>
  <view class="title-line"></view>

  <!-- 勿用 enhanced：原生滚动层会挡住普通 fixed 弹层点击 -->
  <scroll-view scroll-y class="body" show-scrollbar="{{false}}">
    <view class="section-label">{{mineSectionPrefs}}</view>
    <view class="card">
      <view class="row" catchtap="onOpenLang">
        <text class="row-title">{{langLabel}}</text>
        <text class="row-value">{{localeName}}</text>
        <text class="chev">›</text>
      </view>
      <view class="row-line"></view>
      <view class="row" catchtap="onOpenSound">
        <text class="row-title">{{ambientLabel}}</text>
        <text class="row-value">{{ambientName}}</text>
        <text class="chev">›</text>
      </view>
      <view class="row-line"></view>
      <view class="row" catchtap="onOpenCustomScenes">
        <text class="row-title">{{customScenesLabel}}</text>
        <text class="row-value">{{customScenesValue}}</text>
        <text class="chev">›</text>
      </view>
    </view>

    <view class="section-label section-gap">{{prefAlertsSection}}</view>
    <view class="card">
      <view class="row row-switch">
        <text class="row-title">{{prefFinishTone}}</text>
        <switch checked="{{finishTone}}" color="#2f9a68" bindchange="onToggleFinishTone" />
      </view>
      <view class="row-line"></view>
      <view class="row row-switch">
        <text class="row-title">{{prefFinishVibrate}}</text>
        <switch checked="{{finishVibrate}}" color="#2f9a68" bindchange="onToggleFinishVibrate" />
      </view>
      <view class="row-line"></view>
      <view class="row row-switch">
        <text class="row-title">{{prefFinishNotify}}</text>
        <switch checked="{{finishNotify}}" color="#2f9a68" bindchange="onToggleFinishNotify" />
      </view>
      <view class="row-line"></view>
      <view class="row row-switch">
        <text class="row-title">{{prefOvertimeInsight}}</text>
        <switch checked="{{overtimeInsight}}" color="#2f9a68" bindchange="onToggleOvertimeInsight" />
      </view>
      <view class="row-line"></view>
      <view class="row" catchtap="onOpenAlertProfile">
        <text class="row-title">{{alertProfileLabel}}</text>
        <text class="row-value">{{alertProfileName}}</text>
        <text class="chev">›</text>
      </view>
    </view>
    <view class="hint" wx:if="{{alertProfileHint}}">{{alertProfileHint}}</view>

    <view class="section-label section-gap">{{standRitualSection}}</view>
    <view class="card">
      <view class="row" catchtap="onOpenRitual">
        <text class="row-title">{{standRitualLabel}}</text>
        <text class="row-value">{{standRitualName}}</text>
        <text class="chev">›</text>
      </view>
    </view>

    <view class="section-label section-gap">{{storageSection}}</view>
    <view class="card">
      <view class="row" catchtap="onOpenStorage">
        <text class="row-title">{{storageModeLabel}}</text>
        <text class="row-value">{{storageModeName}}</text>
        <text class="chev">›</text>
      </view>
    </view>
    <view class="hint" wx:if="{{storageModeHint}}">{{storageModeHint}}</view>
    <view class="sync-status" wx:if="{{storageSyncStatus}}">{{storageSyncStatus}}</view>

    <view class="card storage-extra">
      <block wx:if="{{showBackupBlock}}">
        <view class="row" catchtap="onShowRecoveryCode">
          <text class="row-title">{{storageBackupShow}}</text>
          <text class="chev">›</text>
        </view>
        <view class="row-line"></view>
      </block>
      <view class="restore-block">
        <text class="restore-label">{{storageRestoreLabel}}</text>
        <input
          class="restore-input"
          value="{{restoreCode}}"
          placeholder="{{storageRestorePlaceholder}}"
          bindinput="onRestoreInput"
          confirm-type="done"
        />
        <text class="restore-hint">{{storageRestoreHint}}</text>
        <view class="storage-btn" bindtap="onRestoreWithCode">{{storageRestoreAction}}</view>
      </view>
    </view>

    <view class="section-label section-gap">{{mineSectionSupport}}</view>
    <view class="card">
      <view class="row" catchtap="onOpenPrivacy">
        <text class="row-title">{{privacyLink}}</text>
        <text class="chev">›</text>
      </view>
      <view class="row-line"></view>
      <view class="row" catchtap="onOpenTerms">
        <text class="row-title">{{termsLink}}</text>
        <text class="chev">›</text>
      </view>
      <view class="row-line"></view>
      <view class="row" catchtap="onOpenAbout">
        <text class="row-title">{{aboutLabel}}</text>
        <text class="chev">›</text>
      </view>
      <view class="row-line"></view>
      <view class="row" catchtap="onFeedback">
        <text class="row-title">{{feedbackLabel}}</text>
        <text class="chev">›</text>
      </view>
      <view class="row-line"></view>
      <view class="row" catchtap="onOpenBeian">
        <text class="row-title">{{beianEntry}}</text>
        <text class="chev">›</text>
      </view>
    </view>
    <view class="safe-bottom"></view>
  </scroll-view>

  <!-- root-portal 脱离页面层级，避免被 scroll-view / 原生组件遮挡 -->
  <root-portal wx:if="{{dialog}}" enable="{{true}}">
  <view
    class="sheet-mask"
    catchtouchmove="noop"
    bindtap="onMaskClose"
  >
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">{{dialogTitle}}</text>
        <!-- 空态用下方「添加场景」；有列表时才显示标题栏 ＋，避免重复入口 -->
        <text
          wx:if="{{dialog === 'scenes' && sceneRows.length > 0 && canAddScene}}"
          class="sheet-add"
          catchtap="onAddScene"
        >＋</text>
        <text class="sheet-close" catchtap="onCloseDialog">✕</text>
      </view>

      <block wx:if="{{dialog === 'lang'}}">
        <view
          wx:for="{{localeOptions}}"
          wx:key="code"
          class="sheet-item {{item.code === locale ? 'sheet-item-on' : ''}}"
          data-code="{{item.code}}"
          catchtap="onPickLocale"
        >{{item.label}}</view>
      </block>

      <block wx:if="{{dialog === 'sound'}}">
        <view
          wx:for="{{soundOptions}}"
          wx:key="id"
          class="sheet-item {{item.id === ambient ? 'sheet-item-on' : ''}}"
          data-id="{{item.id}}"
          catchtap="onPickAmbient"
        >{{item.label}}</view>
      </block>

      <block wx:if="{{dialog === 'storage'}}">
        <view
          wx:for="{{storageOptions}}"
          wx:key="id"
          class="sheet-item {{item.id === storageMode ? 'sheet-item-on' : ''}}"
          data-id="{{item.id}}"
          catchtap="onPickStorage"
        >{{item.label}}</view>
      </block>

      <block wx:if="{{dialog === 'ritual'}}">
        <view
          wx:for="{{ritualOptions}}"
          wx:key="id"
          class="sheet-item {{item.id === standRitual ? 'sheet-item-on' : ''}}"
          data-id="{{item.id}}"
          catchtap="onPickRitual"
        >{{item.label}}</view>
      </block>

      <block wx:if="{{dialog === 'alertProfile'}}">
        <view
          wx:for="{{alertProfileOptions}}"
          wx:key="id"
          class="sheet-item {{item.id === alertProfile ? 'sheet-item-on' : ''}}"
          data-id="{{item.id}}"
          catchtap="onPickAlertProfile"
        >{{item.label}}</view>
      </block>

      <block wx:if="{{dialog === 'scenes'}}">
        <view class="scenes-box" wx:if="{{sceneRows.length === 0}}">
          <text class="scenes-empty-hint">{{customScenesEmptyHint}}</text>
          <view class="btn-ok scenes-add-btn" catchtap="onAddScene">{{customSceneAdd}}</view>
        </view>
        <view class="scenes-list" wx:else>
          <view
            wx:for="{{sceneRows}}"
            wx:key="id"
            class="scene-row"
          >
            <view
              class="scene-main"
              data-id="{{item.id}}"
              catchtap="onEditScene"
            >
              <text class="scene-name">{{item.name}}</text>
              <text class="scene-min">{{item.minLabel}}</text>
            </view>
            <view
              class="scene-use"
              data-id="{{item.id}}"
              catchtap="onUseScene"
            >{{customSceneUse}}</view>
            <view
              class="scene-del"
              data-id="{{item.id}}"
              catchtap="onDeleteScene"
            >✕</view>
          </view>
        </view>
      </block>

      <block wx:if="{{dialog === 'sceneEditor'}}">
        <view class="editor-box">
          <text class="editor-label">{{customSceneNameLabel}}</text>
          <input
            class="editor-name-input"
            maxlength="{{24}}"
            value="{{editorName}}"
            placeholder="{{customSceneNamePlaceholder}}"
            bindinput="onEditorNameInput"
          />
          <text class="editor-label editor-label-gap">{{customMinutesLabel}}</text>
          <view class="editor-min-row">
            <view class="nudge-btn" data-delta="-1" catchtap="onNudgeMinutes">−</view>
            <input
              class="editor-min-input"
              type="number"
              maxlength="3"
              value="{{editorMinutes}}"
              bindinput="onEditorMinutesInput"
            />
            <view class="nudge-btn" data-delta="1" catchtap="onNudgeMinutes">＋</view>
          </view>
          <view class="quick-row">
            <view
              wx:for="{{quickMins}}"
              wx:key="*this"
              class="quick-chip"
              data-min="{{item}}"
              catchtap="onQuickMin"
            >{{item}}</view>
          </view>
          <view class="duration-actions">
            <view class="btn-cancel" catchtap="onCloseSceneEditor">{{cancelLabel}}</view>
            <view
              class="btn-ok {{editorConfirmDisabled ? 'btn-ok-off' : ''}}"
              catchtap="onConfirmSceneEditor"
            >{{confirmLabel}}</view>
          </view>
        </view>
      </block>

      <block wx:if="{{dialog === 'feedback'}}">
        <view class="feedback-box">
          <text class="feedback-hint">{{feedbackHint}}</text>
          <text class="feedback-email" user-select="{{true}}">{{feedbackEmail}}</text>
          <view class="duration-actions">
            <view class="btn-ok" catchtap="onCopyFeedbackEmail">{{copyEmailLabel}}</view>
          </view>
        </view>
      </block>

      <block wx:if="{{dialog === 'backup'}}">
        <view class="backup-sheet">
          <view class="backup-code-wrap">
            <text class="backup-code" user-select="{{true}}">{{backupCode}}</text>
          </view>
          <text class="restore-hint">{{storageBackupHint}}</text>
          <view class="storage-btn" catchtap="onCopyRecoveryCode">{{storageBackupCopy}}</view>
        </view>
      </block>

    </view>
  </view>
  </root-portal>
</view>
