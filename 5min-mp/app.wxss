page {
  height: 100%;
  color: #1f2a24;
  background: #eef6f1;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC",
    "Source Han Sans SC", "Helvetica Neue", sans-serif;
  font-size: 32rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

view,
text,
button,
picker,
scroll-view {
  box-sizing: border-box;
}
