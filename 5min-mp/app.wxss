page {
  --brand: #2f9a68;
  --brand-strong: #248556;
  --brand-soft: #e5f5ec;
  --surface: #ffffff;
  --ink: #1f2a24;
  --muted: #5f6f66;
  --line: #d7e5dc;
  --danger: #d2554a;
  --danger-soft: #ffefed;
  --bg: #eef6f1;
  --bg2: #f2f5f3;
  --bg-bottom: #f4f8f5;
  --glow: #dff0e6;
  --warn: #c9862d;
  --warn-soft: #fff6e8;
  /* 对齐 App：control 22 / card 14 / sm 12 / sheet 18 */
  --radius: 44rpx;
  --radius-card: 28rpx;
  --radius-sm: 24rpx;
  --radius-sheet: 36rpx;
  --radius-dialog: 32rpx;
  --control-h: 104rpx;
  --row-h: 80rpx;
  --suggested-chip-h: 64rpx;
  --ghost-bg: #e8ecea;
  --pad-x: 40rpx;
  --pad-body: 32rpx;
  --section-gap: 32rpx;
  --title-size: 40rpx;
  --body-size: 28rpx;
  --label-size: 26rpx;
  --row-title-size: 30rpx;

  height: 100%;
  color: var(--ink);
  background: var(--bg);
  font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Noto Sans SC", "Source Han Sans SC", "Helvetica Neue", sans-serif;
  font-size: 32rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

@font-face {
  font-family: "Plus Jakarta Sans";
  src: url("/fonts/PlusJakartaSans-Regular.ttf") format("truetype");
  font-weight: 400;
  font-style: normal;
}

@font-face {
  font-family: "Plus Jakarta Sans";
  src: url("/fonts/PlusJakartaSans-Medium.ttf") format("truetype");
  font-weight: 500;
  font-style: normal;
}

@font-face {
  font-family: "Plus Jakarta Sans";
  src: url("/fonts/PlusJakartaSans-SemiBold.ttf") format("truetype");
  font-weight: 600;
  font-style: normal;
}

@font-face {
  font-family: "Plus Jakarta Sans";
  src: url("/fonts/PlusJakartaSans-Bold.ttf") format("truetype");
  font-weight: 700;
  font-style: normal;
}

view,
text,
button,
picker,
scroll-view {
  box-sizing: border-box;
}

/* Shared privacy gate */
.privacy-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.privacy-card {
  width: 100%;
  background: var(--surface);
  border-radius: var(--radius-dialog, 32rpx);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(31, 42, 36, 0.14);
  position: relative;
  overflow: hidden;
}

.privacy-card::before {
  content: "";
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  top: 20rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--brand-soft);
}

.privacy-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
}

.privacy-msg {
  font-size: var(--body-size);
  color: var(--muted);
  line-height: 1.5;
}

.privacy-check {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.check-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 3rpx solid var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.check-on {
  background: var(--brand);
  border-color: var(--brand);
}

.check-mark {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.check-label {
  font-size: var(--body-size);
  color: var(--ink);
  flex: 1;
}

.privacy-links {
  display: flex;
  flex-direction: row;
  gap: 32rpx;
}

.privacy-links .link,
.link {
  font-size: var(--body-size);
  font-weight: 500;
  color: var(--brand-strong);
}

.privacy-btn {
  margin-top: 8rpx;
  height: 100rpx;
  border-radius: var(--radius);
  background: linear-gradient(180deg, #36a872 0%, var(--brand) 55%, var(--brand-strong) 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(47, 154, 104, 0.28);
}

.privacy-btn-off {
  background: var(--brand-soft);
  color: var(--muted);
  box-shadow: none;
  opacity: 0.85;
}
