{
  "description": "如厕计时器 · 5min 微信小程序",
  "packOptions": {
    "ignore": [
      {
        "value": "README.md",
        "type": "file"
      },
      {
        "value": "LICENSE",
        "type": "file"
      },
      {
        "value": "NOTICE",
        "type": "file"
      },
      {
        "value": ".gitignore",
        "type": "file"
      },
      {
        "value": "shared/scenes.json",
        "type": "file"
      },
      {
        "value": "shared/zh-CN.json",
        "type": "file"
      },
      {
        "value": "project.private.config.json",
        "type": "file"
      },
      {
        "type": "glob",
        "value": "private.*.key"
      },
      {
        "type": "glob",
        "value": "**/*.key"
      },
      {
        "type": "glob",
        "value": "assets/*.svg"
